<?xml version="1.0" encoding="utf-8"?>
<!-- لا نسخ احتياطي لبيانات التطبيق: المفتاح مشفّر بمفتاح من Keystore لا ينتقل لجهاز آخر -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </device-transfer>
</data-extraction-rules>
